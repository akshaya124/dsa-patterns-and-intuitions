class Solution {
    int dp[][][];
    public int helper(int i, int j1, int j2, int[][] grid){
        int n = grid.length;
        int m = grid[0].length;
        if(j1<0 || j1>=m || j2<0 || j2>=m){
            return (int)-1e8;
        }
        if(i == n-1){
            if(j1 == j2){
                return dp[i][j1][j2] = grid[i][j1];
            }else{
                return dp[i][j1][j2] = grid[i][j2]+grid[i][j1];
            }
        }
        if(dp[i][j1][j2] != -1){
            return dp[i][j1][j2];
        }
        int max = Integer.MIN_VALUE;
        for(int d1 = -1;d1<=1;d1++){
            for(int d2 = -1;d2<=1;d2++){
                if(j1 == j2){
                    max = Math.max(max,grid[i][j1]+helper(i+1,j1+d1,j2+d2,grid));
                }else{
                    max = Math.max(max,grid[i][j1]+grid[i][j2]+helper(i+1,j1+d1,j2+d2,grid));
                }
            }
        }
        return dp[i][j1][j2] = max;
    }
    public int cherryPickup(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        dp = new int[n][m][m];
        for(int row[][] : dp){
            for(int col[] : row)
            Arrays.fill(col,-1);
        }
        return helper(0,0,m-1,grid);
    }
}
