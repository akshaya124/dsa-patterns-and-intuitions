class Solution {
   
    public int helper(int n, List<List<Integer>> tri){
        int prev[] = new int[n];
        for(int j = 0;j<n;j++){
            prev[j] = tri.get(n-1).get(j);
        }
        for(int i = n-2;i>=0;i--){
            int curr[] = new int[n];
            for(int j = i;j>=0;j--){
                int down = tri.get(i).get(j) + prev[j];
                int dia = tri.get(i).get(j) + prev[j+1];
                curr[j] = Math.min(down,dia);
            }
            prev = curr;
        }
        return prev[0];
    }
    public int minimumTotal(List<List<Integer>> triangle) {
        int n = triangle.size();
        
        return helper(n,triangle);
    }
}
