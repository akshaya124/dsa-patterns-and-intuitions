class Solution {
    static boolean dp[][];
    static boolean helper(int arr[],int sum){
        int n = arr.length;
       for(int i = 0;i<n;i++){
           dp[i][0] = true;
       }
       if(arr[0]<=sum){ 
       dp[0][arr[0]] = true;
       }
       for(int i = 1;i<n;i++){
           for(int j = 1;j<=sum;j++){
               boolean nottake = dp[i-1][j];
               boolean take = false;
               if(arr[i]<=j){
                   take = dp[i-1][j - arr[i]];
               }
               dp[i][j]  = take | nottake;
           }
       }
       return dp[n-1][sum];
      
    }
    static boolean isSubsetSum(int arr[], int sum) {
        // code here
        int n = arr.length;
        dp = new boolean[n+1][sum+1];
        
        return helper(arr,sum);
    }
}
