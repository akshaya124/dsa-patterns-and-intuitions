class Solution {
    int dp[][];
    public int helper(int i , int j,int[][] grid){
        if(i == 0 && j == 0){
            return dp[i][j] = grid[0][0];
        }
        if(i<0 || j<0){
            return Integer.MAX_VALUE;
        }
        if(dp[i][j] != -1){
            return dp[i][j];
        }
        int up = (helper(i-1,j,grid) == Integer.MAX_VALUE)? Integer.MAX_VALUE:grid[i][j]+helper(i-1,j,grid);
        int left = ( helper(i,j-1,grid) == Integer.MAX_VALUE)?Integer.MAX_VALUE:grid[i][j]+helper(i,j-1,grid);
        return dp[i][j] = Math.min(up,left);
    }
    public int minPathSum(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        dp = new int[n][m];
        for(int row[] : dp){
            Arrays.fill(row,-1);
        }
        return helper(n-1,m-1,grid);
    }
}
