class Solution {
    int dp[][];
    public boolean isSubset(int[] nums, int target, int idx){
        if(target == 0) return true;
        if(idx == 0){
            return nums[0] == target;
        }
        if(dp[idx][target] != -1){
            return dp[idx][target] == 1;
        }
        boolean nottake = isSubset(nums,target,idx-1);
        boolean take = false;
        if(target>=nums[idx]){
            take = isSubset(nums,target-nums[idx],idx-1);
            dp[idx][target] = (take | nottake)?1:0;
        }
        return take | nottake;
    }
    public boolean canPartition(int[] nums) {
     int n = nums.length;
     int sum = 0;
     for(int ele : nums){
        sum += ele;
     }
     if(sum%2 != 0){
        return false;
     }
     dp = new int[n][sum+1];
     for(int row[]:dp){
        Arrays.fill(row,-1);
     }
     return isSubset(nums,sum/2,n-1);
}
}
