class Solution {
    public boolean isSubset(int[] nums, int target, int idx){
        if(target == 0) return true;
        if(idx == 0){
            return nums[0] == target;
        }
        boolean nottake = isSubset(nums,target,idx-1);
        boolean take = false;
        if(target>=nums[idx]){
            take = isSubset(nums,target-nums[idx],idx-1);
        }
        return take | nottake;
    }
    public boolean canPartition(int[] nums) {
     int n = nums.length;
     int sum = 0;
     for(int ele : nums){
        sum += ele;
     }
     if(sum%2 != 0){
        return false;
     }
     return isSubset(nums,sum/2,n-1);
}
}
