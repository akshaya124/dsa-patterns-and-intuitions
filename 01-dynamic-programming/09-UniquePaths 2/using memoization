class Solution {
    int dp[][];
    public int helper(int i, int j,int[][] obstacles){
        if(i>=0 && j>=0 && obstacles[i][j] == 1){
            return 0;
        }
        if(i == 0 && j == 0){
            return 1;
        }
        if(i<0 || j<0){
            return 0;
        }
        if(dp[i][j] != -1){
            return dp[i][j];
        }
        int up = helper(i-1,j,obstacles); 
        int left =  helper(i,j-1,obstacles);
        return dp[i][j] = up + left;
    }
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        int n = obstacleGrid.length;
        int m = obstacleGrid[0].length;
        dp = new int[n][m];
        for(int[] row : dp){
            Arrays.fill(row,-1);
        }
        return helper(n-1,m-1,obstacleGrid);
    }
}
