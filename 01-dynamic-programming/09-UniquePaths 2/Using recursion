class Solution {
    public int helper(int i, int j,int[][] obstacles){
        if(obstacles[i][j] == 1){
            return 0;
        }
        if(i == 0 && j == 0){
            return 1;
        }
        if(i<0 || j<0){
            return 0;
        }
        int up = 0;
        int left = 0;
        if(i>0 && obstacles[i-1][j] != 1){
           up = helper(i-1,j,obstacles); 
        }
        if(j>0 && obstacles[i][j-1] != 1){
            left = helper(i,j-1,obstacles);
        }
        return up + left;
    }
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        int n = obstacleGrid.length;
        int m = obstacleGrid[0].length;
        return helper(n-1,m-1,obstacleGrid);
    }
}
