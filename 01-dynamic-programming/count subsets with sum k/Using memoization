class Solution {
    static int helper(int idx, int target, int[] arr,int[][] dp){
        if(idx<0){
            return (target == 0)?1:0;
        }
        if(dp[idx][target] != -1){
            return dp[idx][target];
        }
        int nottpick = helper(idx-1,target,arr,dp);
        int pick = 0;
        if(target>=arr[idx]){
            pick = helper(idx-1,target-arr[idx],arr,dp);
        }
        return dp[idx][target] = pick + nottpick;
    }
    static int perfectSum(int[] arr, int target) {
        // code here
        int n = arr.length;
        int dp[][] = new int[n][target+1];
        for(int row[] : dp){
            Arrays.fill(row,-1);
        }
        return helper(n-1,target,arr,dp);
    }
}
